# map-project-agent — .env 템플릿
# 실제 값은 `.env`에 채우고 절대 commit 하지 않는다.
# 단일 docker-compose 실행 시 ../map-project-infra/.env.example 과 맞춘다.
# 이름 규칙: agent 만 읽는 값은 AGENT_, 다른 서비스와 같이 읽는 값은 MAP_PROJECT_ 로
# 시작한다. 이름이 틀리면 조용히 무시되고 기본값이 쓰인다(extra="ignore").
#
# **로컬 실행용 기본값이다. 외부에 열기 전에 반드시 AGENT_AUTH_ENFORCED=true 로 켜고
# MAP_PROJECT_INTERNAL_SERVICE_TOKEN·MAP_PROJECT_LOCATION_WIRE_KEY 같은 키·토큰을 직접 만들어 채운다.**

# ── (0) LLM 제공자 ─────────────────────────────────────────────
# fake(기본): 키·네트워크·비용 없이 도는 결정적 합성 제공자. 결과 문장마다 [합성] 표시.
# gemini: 아래 (4) 의 MAP_PROJECT_GEMINI_API_KEY 에 자기 키를 넣었을 때만 고른다.
AGENT_LLM_PROVIDER=fake

# ── (1) PostgreSQL (LangGraph 체크포인터, schema=langgraph) ─────────
# false(빠른 시작)면 체크포인터 없이 기동하고 Postgres 를 쓰지 않는다.
# true 면 역할 SQL(scripts/database-roles.sql)과 마이그레이션
# (python -m map_project_agent.checkpoint_migrate)을 먼저 끝내야 하고, 연결·스키마
# 검증이 실패하면 부팅을 멈춘다. 봉인 열쇠(AGENT_CHECKPOINT_ENC_*)도 필수다.
AGENT_CHECKPOINT_ENABLED=false
MAP_PROJECT_POSTGRES_DB=map
# 런타임은 제한된 역할 map_agent_runtime 으로만 붙는다(다른 역할이면 부팅 거부).
AGENT_DATABASE_USER=map_agent_runtime
AGENT_DATABASE_PASSWORD=
MAP_PROJECT_POSTGRES_HOST=postgres
MAP_PROJECT_POSTGRES_PORT=5432
AGENT_LANGGRAPH_SCHEMA=langgraph
# 체크포인트 봉인 열쇠: "kid:base64" 를 쉼표로 잇는다. 각 값은 openssl rand -base64 32.
# MAP_PROJECT_LOCATION_WIRE_KEY 와 같은 값이면 부팅 거부.
AGENT_CHECKPOINT_ENC_KEYS=
AGENT_CHECKPOINT_ENC_ACTIVE_KID=

# ── (2) Redis Streams (agent:jobs:done / agent:jobs:status 발행) ────
# Streams 는 DB2 를 사용한다 — map-project-user 컨슈머 redis.db-streams 기본값(2)과
# 일치해야 추천 결과가 정상 수신된다.
MAP_PROJECT_REDIS_URL=redis://redis:6379
MAP_PROJECT_REDIS_DB_STREAMS=2
MAP_PROJECT_STREAM_NAME=agent:jobs:done
MAP_PROJECT_STREAM_MAXLEN=2000
AGENT_STATUS_STREAM_NAME=agent:jobs:status
AGENT_STATUS_STREAM_MAXLEN=2000
# Gemini 호출 한도(token-bucket/일일 카운터)는 DB3 를 사용한다(gemini 제공자일 때만).
MAP_PROJECT_REDIS_DB_RATELIMIT=3

# ── (3) 내부 서비스 인증·라우팅 (BFF↔에이전트, 에이전트↔허브) ───────
# 설정 시 /v1/recommend 인바운드 요청의 X-Internal-Token 헤더를 검증하고,
# hub 아웃바운드 호출에 동일 토큰을 부착한다. 미설정 시 검증 생략(경고 로그).
MAP_PROJECT_INTERNAL_SERVICE_TOKEN=
# true 면 lifespan 부팅 시 MAP_PROJECT_INTERNAL_SERVICE_TOKEN 이 비어 있으면 중단(fail-fast).
# false(기본)면 토큰 미설정을 허용(경고 로그와 함께 검증 생략) — 로컬 전용.
AGENT_AUTH_ENFORCED=false
# 서비스 사이 좌표를 감싸는 열쇠(필수). hub·BFF 와 같은 값. 비어 있으면 부팅을 멈춘다.
# 만드는 법: openssl rand -base64 32
MAP_PROJECT_LOCATION_WIRE_KEY=
MAP_PROJECT_HUB_BASE_URL=http://hub:8000
# hub HTTP 전체 timeout(초). AgentSettings 기본값(5.0)과 일치시킨다.
AGENT_HUB_TIMEOUT_SECONDS=5

# ── 후보·랭킹·시간축 ─────────────────────────────────────────────
# 선정 프롬프트에 실을 후보 수 상한 = max(BASE, 여행일수 × PER_DAY).
AGENT_CANDIDATES_MAX_BASE=40
AGENT_CANDIDATES_PER_DAY=12
# 테마 친화 가점. AGENT_RULES_ENABLED=false 면 함께 꺼진다.
AGENT_PERSONALIZATION_ENABLED=true
# 성향별 저장 비율 통계 파일(eval/segment_stats.py 로 만든다). 비우면 쓰지 않는다.
AGENT_SEGMENT_STATS_PATH=
# rules_filter/score_and_rank 가 hub 룰 엔드포인트를 호출한다. false 면 두 노드가
# 그대로 통과한다(kill-switch — hub 장애/회귀 시 즉시 무력화).
AGENT_RULES_ENABLED=true
# 체류시간·방문 시각 계산. false 면 build_timeline·fit_time_budget 이 그대로 통과한다.
AGENT_TIMELINE_ENABLED=true
# 장소 사이에 두는 여유(분).
AGENT_TIMELINE_BUFFER_MINUTES=10

# ── 리뷰 보강(hub /v1/reviews) ───────────────────────────────────
# 켜면 grounded 경로에서 상위 후보에 블로그 리뷰 스니펫을 붙여 프롬프트를 보강한다.
# 제3자 본문이 모델 프롬프트에 실리므로 기본 꺼짐(opt-in).
AGENT_REVIEWS_ENRICH_ENABLED=false
# 리뷰를 조회할 상위 후보 수 / 후보당 요청 리뷰 수.
AGENT_REVIEWS_MAX_PLACES=3
AGENT_REVIEWS_DISPLAY=5
# 잡 1건이 hub /v1/reviews 를 호출할 총 상한(안전망).
AGENT_REVIEWS_FETCH_CAP_PER_JOB=10

# ── 블로그 요약 파이프라인 ─────────────────────────────────────
# 추천과 분리된 별도 파이프라인이다. 제3자 본문을 모델로 보내므로 기본 꺼짐(opt-in).
# false 면 요약 엔드포인트가 모델을 부르지 않고 빈 결과를 준다.
AGENT_SUMMARY_ENABLED=false
# 한 요청에 담을 장소 수 상한(요청 스키마 상한과 같은 값, 배포 없이 낮출 수 있다).
AGENT_SUMMARY_MAX_PLACES=7
# 요약 요청 1건당 LLM 호출 예산: 본 호출 1 + 형식 이탈 시 교정 재시도 1.
AGENT_SUMMARY_MAX_LLM_CALLS=2

# ── (4) Gemini (AGENT_LLM_PROVIDER=gemini 일 때만: 장소 선정·추천 이유·요약) ─
MAP_PROJECT_GEMINI_API_KEY=
MAP_PROJECT_GEMINI_MODEL=gemini-3.8-flash
# 외부 API 한도(문서화): RPM 10 / RPD 250. 집행은 아래 두 값이 담당한다.
AGENT_GEMINI_RPM_LIMIT=10
AGENT_GEMINI_RPD_LIMIT=250
# agent 자체 일일 상한(200/일. 외부 한도 250 중 50 은 수동 점검용 여유). KST 자정 리셋.
MAP_PROJECT_GEMINI_RPD_CAP=200
# 추천 요청 1건당 LLM 호출 하드 예산(장소 선정 1 + 이유 1 + 교정 재시도 여유 1).
# 동선은 좌표로 계산해 모델을 부르지 않는다. 블로그 요약은 별도 예산이다.
AGENT_GEMINI_MAX_CALLS_PER_REQUEST=3
# 구조화 출력 결정성/신뢰성 파라미터.
AGENT_GEMINI_TEMPERATURE=0.2
# thinking 토큰이 max_output_tokens 를 함께 소비한다. 과소 시
# JSON 절단으로 검증 실패 → 여유 마진 8192.
AGENT_GEMINI_MAX_OUTPUT_TOKENS=8192
# thinking 예산: 0=끔(구조화 추출 신뢰성 최적, 기본), 양수=허용, 음수=모델 기본.
AGENT_GEMINI_THINKING_BUDGET=0

# ── 전송 재시도(503/500 완화) ─────────────────────────────────
# 무료 티어 503 "high demand" 빈발 대응. SDK 내장 지수 백오프 재시도를 켠다.
# 재시도는 요청 예산·호출 한도 회계와 무관(전송 계층).
AGENT_GEMINI_RETRY_ATTEMPTS=3            # 총 시도 수(1 이하=재시도 끔)
AGENT_GEMINI_RETRY_INITIAL_DELAY=1.0     # 백오프 초기 지연(초)
AGENT_GEMINI_RETRY_MAX_DELAY=8.0         # 백오프 상한(초)
# 재시도 대상 코드. 429 는 절대 넣지 말 것(RateLimiter 이중 소진). 빈값=끔.
AGENT_GEMINI_RETRY_STATUS_CODES=503,500
# per-attempt(시도별) HTTP 타임아웃(초). 시도 1건의 hang 을 bound.
AGENT_GEMINI_HTTP_TIMEOUT_SECONDS=30

# ── (5) 잡 타이밍 ───────────────────────────────────────────────
# per-attempt(30s) × attempts(3) + 백오프(≈5s) ≈ 95s 를 담도록 호출당
# outer wait_for 를 100s 로 둔다(재시도가 wait_for 에 잘리지 않게).
AGENT_GEMINI_TIMEOUT_SECONDS=100
# 잡 전체 wall-clock 캡. 이론최악(재시도 포함)은 넘을 수 있으나 본 캡이
# 300s 에서 강제 종료. BFF 의 잡 대기 상한(10분) 안에 들어온다.
# SHUTDOWN_GRACE 는 +10s 연동.
AGENT_JOB_TIMEOUT_SECONDS=300
AGENT_SHUTDOWN_GRACE_SECONDS=310

# ── (6) 관측 ───────────────────────────────────────────────────
AGENT_LOG_LEVEL=INFO
# LangSmith 실행 기록 전송. 기본 꺼짐 — 켜면 LangGraph 실행이 LangSmith 로 간다.
# agent 가 시작할 때 이 값을 SDK 가 읽는 LANGSMITH_* 이름으로 넘긴다.
AGENT_LANGSMITH_TRACING=false
AGENT_LANGSMITH_API_KEY=
AGENT_LANGSMITH_PROJECT=
AGENT_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 학습 수집: 학습 전용 신호 생성/Streams 발행은 기본 꺼짐. 사용량 계측은 유지.
MAP_PROJECT_TRAINING_CAPTURE_ENABLED=false
